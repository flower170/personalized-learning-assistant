# ============================================================
# 项目级 .dockerignore
# ============================================================

# Python
**/__pycache__
**/.venv
**/*.pyc
**/*.pyo
**/*.egg-info

# Node
**/node_modules
**/.vite

# IDE
**/.idea
**/.vscode
**/*.swp
**/*.swo

# 操作系统
**/.DS_Store
**/Thumbs.db

# 环境变量（含敏感信息）
**/.env

# 临时 / 日志
**/.pytest_cache
**/*.log
**/.claude

# 文档 / 测试数据（Docker 不需要）
**/*.docx
**/*.pdf
**/知识库api.txt
