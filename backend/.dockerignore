# ============================================================
# 后端构建上下文 .dockerignore（构建上下文为 backend/）
# ============================================================

# Python
__pycache__
*.pyc
*.pyo
*.egg-info
.venv

# 环境变量（含真实 API 密钥，绝不能进镜像）
.env
.env.*

# 本地数据 / 日志（运行期生成，不需要进镜像）
logs
*.log
.next
static/uploads
static/mindmap
data/profiles

# IDE / 其他
.idea
.vscode
.claude
*.bak
