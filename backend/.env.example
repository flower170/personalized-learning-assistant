# ============================================================
# A3 多智能体学习系统 — 环境变量模板
# 复制为 .env 后填写真实值： cp .env.example .env
# ============================================================

# ===== 讯飞星火 Spark（主力模型，必填）=====
# 控制台开通：https://console.xfyun.cn/services/bm35
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=

# ===== 讯飞知识库（可选）=====
KB_API_URL=https://chatdoc.xfyun.cn/openapi/v1

# ===== 智谱 GLM（可选，OpenAI 兼容）=====
# 控制台：https://open.bigmodel.cn/
GLM_API_KEY=

# ===== 通义千问 Dashscope（可选，OpenAI 兼容）=====
# 控制台：https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=

# ===== MySQL（可选，不配置则自动降级为文件存储）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=a3_learning

# ===== Redis（可选，不配置则自动降级为内存缓存）=====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
